{
  "name": "dsh-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "面向 DSH 的去中心化 AI 社交与创作网络：发现 · 好友 · 分享 · 直播 · 节点共建",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "p2p",
    "social",
    "session-share",
    "live"
  ],
  "license": "MIT",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test --test-timeout=120000 \"test/*.test.js\" \"test/network/*.test.js\"",
    "test:only": "node --test --test-timeout=120000 \"test/*.test.js\" \"test/network/*.test.js\"",
    "check": "node scripts/build.mjs && node --test --test-timeout=120000 \"test/*.test.js\" \"test/network/*.test.js\"",
    "verify:live": "node scripts/verify-live-node.mjs",
    "test:unit": "node --test --test-timeout=120000 \"test/*.test.js\"",
    "test:network": "node --test --test-timeout=120000 \"test/network/*.test.js\"",
    "lab": "node scripts/net-lab.mjs",
    "test:virtual": "node --test --test-timeout=120000 \"test/network/virtual-net.test.js\"",
    "doctor": "node scripts/doctor.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-test-renderer": "^18.3.1"
  },
  "engines": {
    "node": ">=22.19"
  }
}
